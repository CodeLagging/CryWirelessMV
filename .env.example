# CryWirelessMV environment variables
# Copy to `.env` if you want to override defaults. None of these are secrets.
# This file is documentation only — the app resolves paths via core/set_path.py
# and does not auto-load a .env.

# --- Set automatically by sudo (do NOT set these yourself) ---
# When you run `sudo python3 main.py`, sudo exports the original user's IDs so
# the tool can drop generated files back to your ownership instead of root's.
SUDO_UID=1000
SUDO_GID=1000

# --- Resolved at runtime ---
# PYTHONPATH is set by core/set_path.py so `core.*` imports resolve regardless
# of the working directory. Only override if you run the modules out-of-tree.
PYTHONPATH=.

# --- Optional, read by the app ---
# Directory for the rotating forensic log (see core/log_config.py).
# Defaults to ~/.cwmv/logs when unset.
CWMV_LOG_DIR=~/.cwmv/logs

# Force the classic console UI instead of the Textual TUI for the APCC module.
# APCC_CLASSIC=1
